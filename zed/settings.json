// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "debugger": {
    "format_dap_log_messages": false
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "show_type_hints": false,
    "show_value_hints": false,
  },
  "show_edit_predictions": false,
  "disable_ai": true,
  "languages": {
    "Rust": {
      "tasks": {
        "prefer_lsp": true
      },
      "inlay_hints": {
        "enabled": true,
      },
    },
  },
  "cursor_blink": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "dock": "bottom",
  },
  "vim_mode": false,
  "outline_panel": {
    "dock": "right",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_features": {
    "calt": false,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "autosave": "on_focus_change",
  "hard_tabs": false,
  "tab_size": 2,
}
